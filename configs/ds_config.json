{
  "train_micro_batch_size_per_gpu": 2,
  "gradient_accumulation_steps": 16,
  "gradient_clipping": 1.0,

  "bf16": {
    "enabled": true
  },

  "optimizer": {
    "type": "AdamW",
    "params": {
      "lr": 2e-4,
      "betas": [0.9, 0.95],
      "eps": 1e-8,
      "weight_decay": 0.1
    }
  },

  "scheduler": {
    "type": "WarmupCosineLR",
    "params": {
      "warmup_min_ratio": 0.0,
      "warmup_num_steps": 1900,
      "cos_min_ratio": 0.1,
      "total_num_steps": 76294,
      "warmup_type": "linear"
    }
  },

  "zero_optimization": {
    "stage": 2,
    "allgather_partitions": true,
    "allgather_bucket_size": 2e8,
    "overlap_comm": true,
    "reduce_scatter": true,
    "reduce_bucket_size": 2e8,
    "contiguous_gradients": true
  },

  "steps_per_print": 10,
  "wall_clock_breakdown": false,

  "checkpoint": {
    "checkpoint_dir": "out-qwen-moe/ds-checkpoints",
    "save_interval": 5000,
    "save_latest": true,
    "keep_num_ckpt": 3
  }
}
